{
  "name": "jeveryword",
  "version": "0.1.2",
  "description": "Field extraction, PII detection and exact quotes, built on TypeSafe's Jev. It numbers the words of a text, Jev picks numbers, and you get the exact substring back with offsets and a probability.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./client": {
      "types": "./src/client.d.ts",
      "default": "./src/client.mjs"
    },
    "./testing": {
      "types": "./src/testing.d.ts",
      "default": "./src/testing.mjs"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "examples",
    "skills"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "jev",
    "typesafe",
    "extraction",
    "pii",
    "span",
    "tokens",
    "structured-data"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "Justin Krup",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkrup/jeveryword.git"
  },
  "homepage": "https://github.com/jkrup/jeveryword#readme"
}
